{
  "name": "HTS-simulator2",
  "version": "2.4.5",
  "author": "hansy2577",
  "description": "a 2D transport simulator",

  "keywords": ["Game","transport","open source"],
  "license": "MIT",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-packager . HTS2 --platform=win32 --arch=x64 --out=dist --overwrite"
  },

  "devDependencies": {
    "electron": "^42.4.0",
    "electron-packager": "^17.1.2"
  },


  "build": {
    "icon": "icon.ico",
    "appId": "com.h.project",
    "productName": "HTS",
    "directories": {
      "buildResources": "assets",
      "output": "output-exe"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HTS-simulator2"
    }
  }
}
